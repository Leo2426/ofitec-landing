<nav class="o-nav" id="main-nav">
  <div class="o-wrapper o-nav__inner">
    <a class="o-nav__brand" href="/">
      <img class="o-nav__logo-icon" src="/icono-ofitec-blanco.svg" alt="">
      <img class="o-nav__logo-text" src="/Letras-Ofitec-Blanco.svg" alt="Ofitec">
    </a>

    <ul class="o-nav__links">
      <li><a class="o-nav__link" href="/">Inicio</a></li>
      <li><a class="o-nav__link" href="/nosotros">Nosotros</a></li>
      <li><a class="o-nav__link" href="/productos">Productos</a></li>
    </ul>
  </div>
</nav>

<script>
  const nav = document.getElementById('main-nav');
  const onScroll = () => {
    if (window.scrollY > 40) {
      nav?.classList.add('scrolled');
    } else {
      nav?.classList.remove('scrolled');
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .o-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 1.1rem 0;
    transition: background 300ms ease, backdrop-filter 300ms ease,
                box-shadow 300ms ease, padding 300ms ease;
  }

  /* Estado inicial: transparente sobre el hero */
  .o-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* ── Al hacer scroll: glassmorphism ── */
  .o-nav.scrolled {
    padding: 0.65rem 0;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  }

  /* ── Brand ── */
  .o-nav__brand {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
  }

  .o-nav__logo-icon {
    width: 40px;
    height: auto;
  }

  .o-nav__logo-text {
    width: 90px;
    height: auto;
  }

  /* Cuando está scrolled, los logos blancos no se ven sobre fondo claro.
     Se soluciona con un filtro de inversión + corrección de color */
  .o-nav.scrolled .o-nav__logo-icon,
  .o-nav.scrolled .o-nav__logo-text {
    filter: invert(1) sepia(1) saturate(3) hue-rotate(100deg) brightness(0.6);
  }

  /* ── Links ── */
  .o-nav__links {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.25rem;
  }

  .o-nav__link {
    color: rgba(255, 255, 255, 0.92);
    text-decoration: none;
    font-size: 0.97rem;
    font-weight: 500;
    padding: 0.4rem 0.85rem;
    border-radius: 6px;
    transition: color 200ms ease, background 200ms ease;
  }

  .o-nav__link:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.15);
  }

  /* Links en modo scrolled */
  .o-nav.scrolled .o-nav__link {
    color: var(--color-text);
  }

  .o-nav.scrolled .o-nav__link:hover {
    color: var(--color-primary);
    background: var(--color-primary-bg);
  }

  /* ── Responsive ── */
  @media (max-width: 600px) {
    .o-nav__logo-icon {
      display: none;
    }
    .o-nav__logo-text {
      width: 70px;
    }
    .o-nav__link {
      font-size: 0.82rem;
      padding: 0.35rem 0.5rem;
    }
  }
</style>
