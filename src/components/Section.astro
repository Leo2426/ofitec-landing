---
interface Props {
  title: string;
  eyebrow?: string;
  subtitle?: string;
  dark?: boolean;
  subtle?: boolean;
}

const {
  title,
  eyebrow,
  subtitle,
  dark = false,
  subtle = false,
} = Astro.props;
---

<section class:list={["o-section", { "o-section--dark": dark, "o-section--subtle": subtle }]}>
  <div class="o-wrapper">
    <div class="o-section-header">
      {eyebrow && <span class="o-section-header__eyebrow">{eyebrow}</span>}
      <h2 class:list={["o-section-header__title", { "o-section-header__title--light": dark }]}>
        {title}
      </h2>
      <div class="o-section-header__divider"></div>
      {subtitle && (
        <p class:list={["o-section-header__subtitle", { "o-section-header__subtitle--light": dark }]}>
          {subtitle}
        </p>
      )}
    </div>
    <slot />
  </div>
</section>
