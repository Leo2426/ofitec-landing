---
interface Props {
  description: string;
  icon?: string;
  icon_local?: string;
  islocal?: boolean;
}

const { description, icon, icon_local = "", islocal } = Astro.props;
---

<div class="o-feature-card">
  <div class="o-feature-card__icon">
    {islocal
      ? <img src={icon_local} alt="" />
      : <i class={icon}></i>
    }
  </div>
  <p class="o-feature-card__desc">{description}</p>
</div>

<style>
  .o-feature-card {
    background: var(--color-surface-0);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.75rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    transition: border-color var(--transition), box-shadow var(--transition), transform var(--transition);
  }

  .o-feature-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-4px);
  }

  .o-feature-card__icon {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-sm);
    background: var(--color-primary-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .o-feature-card__icon i {
    font-size: 1.4rem;
    color: var(--color-primary);
  }

  .o-feature-card__icon img {
    width: 1.75rem;
    height: 1.75rem;
    object-fit: contain;
  }

  .o-feature-card__desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }
</style>
