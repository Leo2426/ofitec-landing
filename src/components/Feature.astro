---
interface Props{
    description: string;
    icon?: string;
    icon_local?: string;
    islocal?: boolean;
}

const {description, icon, icon_local="", islocal} = Astro.props;
---
<div class="card card-feature text-center mb-3" style="width: 18rem;">
      
    <div class="card-img d-flex justify-content-center align-items-center"> <!-- Here I create a New Div for image with class name card_img -->
      {islocal && <img src={icon_local} alt="icon" />}
      {!islocal && <i class= {icon}></i> }

    </div>

    <div class="card-body">
      <p class="card-text">{description}</p>
    </div>


</div>



<style>
     i{
    font-size: 3rem;
    color: rgb(255, 255, 255);
  }    img{
    width: 4rem;
  }


.card-img {
    width: 7.5rem;
    height: 7.5rem;
    overflow: hidden;
    border-radius: 100%;
    margin: -50px auto 0;
    background-color: rgb(52, 163, 110);
}

.card-feature{
    border: none;
    box-shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;
  }

  .card-text{
    padding: 0rem 1rem 1rem 1rem;
  }

  .card{
    border-radius: 10px;
    margin: 5rem 1rem 1rem 1rem;
  }

</style>