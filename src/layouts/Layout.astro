---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { WHATSAPP_NUMBER } from "../config/constants";

interface Props{
  title: string;
  description?: string;
}

const {
  title,
  description = "Ofitec — Sistema de Facturación Electrónica para tu negocio. Emite comprobantes, controla inventarios y gestiona tu empresa desde cualquier lugar."
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://ofitec.netlify.app");
---
<!DOCTYPE html>
  <html lang="esp">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="icon" href="/icono-ofitec-celeste.svg">

        <!-- SEO -->
        <title>{title} | Ofitec</title>
        <meta name="description" content={description}>
        <link rel="canonical" href={canonicalURL}>

        <!-- Open Graph -->
        <meta property="og:type" content="website">
        <meta property="og:url" content={canonicalURL}>
        <meta property="og:title" content={`${title} | Ofitec`}>
        <meta property="og:description" content={description}>
        <meta property="og:image" content="https://ofitec.netlify.app/icono-ofitec-celeste.svg">
        <meta property="og:locale" content="es_PE">

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary">
        <meta name="twitter:title" content={`${title} | Ofitec`}>
        <meta name="twitter:description" content={description}>

        <!-- Preconnect para CDNs -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="preconnect" href="https://cdn.jsdelivr.net">

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4bw+/aepP/YC94hEpVNVgiZdgIC5+VKNBQNGCHeKRQN+PtmoHDEXuppvnDJzQIu9" crossorigin="anonymous">
        <link rel="stylesheet" href="https://pro.fontawesome.com/releases/v6.0.0-beta3/css/all.css">

        <!-- Schema.org JSON-LD -->
        <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "SoftwareApplication",
          "name": "Ofitec",
          "applicationCategory": "BusinessApplication",
          "description": "Sistema de Facturación Electrónica para negocios y emprendimientos en Perú",
          "url": "https://ofitec.netlify.app",
          "operatingSystem": "Web, Android",
          "offers": {
            "@type": "AggregateOffer",
            "priceCurrency": "PEN",
            "lowPrice": "50",
            "highPrice": "120"
          },
          "provider": {
            "@type": "Organization",
            "name": "Ofitec",
            "url": "https://ofitec.netlify.app",
            "contactPoint": {
              "@type": "ContactPoint",
              "contactType": "customer support",
              "availableLanguage": "Spanish"
            }
          }
        }
        </script>
    </head>
    <body>
        <Navbar/>
        <slot/>
        <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-HwwvtgBNo3bZJJLYd8oVXjrBZt8cqVSpeBNS5n7C8IVInixGAoxmnlMuBnhbgrkm" crossorigin="anonymous"></script>
        <a href={`https://wa.me/${WHATSAPP_NUMBER}/?text=Hola, estoy interesado en el sistema de facturación`} target="_blank" rel="noopener noreferrer" class="whatsapp-float" aria-label="Contactar por WhatsApp">
          <div class="whatsapp-icon">
            <i class="fab fa-whatsapp"></i>
          </div>
        </a>
        <Footer></Footer>
    </body>
  </html>





<style>
  @import url('https://fonts.googleapis.com/css2?family=Andika:wght@700&family=Inter&family=Open+Sans:wght@700&display=swap');

body{
    font-family: 'Inter', sans-serif;
}
p{
    font-size: 1.2rem;
  }


    /* Estilos para el botón flotante */
    .whatsapp-float {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 999;
  }

  /* Estilos para el ícono de WhatsApp */
  .whatsapp-icon {
    display: block;
    width: 60px;
    height: 60px;
    background-color: #25D366;
    color: #fff;
    text-align: center;
    line-height: 60px;
    border-radius: 50%;
    font-size: 24px;
    box-shadow: 0px 2px 5px rgba(0, 0, 0, 0.1);
    transition: background-color 0.3s, transform 0.3s;
  }

  /* Cambio de color y escala al pasar el cursor */
  .whatsapp-icon:hover {
    background-color: #128C7E;
    transform: scale(1.1);
  }

</style>