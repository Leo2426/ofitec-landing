---
import Layout from "../layouts/Layout.astro"
import Section from "../components/Section.astro"
import Feature from "../components/Feature.astro"
import Hero from "../components/Hero.astro"

export const back_color_secondary = "rgb(48 48 68)"
---

<Layout title="Ofitec">
  
  <Hero background_image="/inicio.jpg">
    <h1 class="text-center titulo">Sistema de Facturación Electrónica</h1>
    <div class="container d-flex justify-content-center">
      <a href="https://demo.ofitecfacturas.com/" target="_blank"><button data-bs-toggle="modal" data-bs-target="#exampleModal" type="button" class="btn-hero btn btn-success mx-auto">PROBAR SISTEMA GRATIS</button></a>
    </div>

<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">DATOS PARA INGRESAR</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p><span style="font-weight: bold" >Correo: </span> demo@gmail.com </p>
        <p><span style="font-weight: bold" >Contraseña: </span> 123456 </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
  </Hero>

  <Section title="Controla tu Negocio">

    <div class="container">

      <!-- Primera Fila -->
      <div class="row justify-content-center">
        <div class="col d-flex justify-content-center">
          <Feature description="Agrega tu logo y tus datos para que salga en tus comprobantes" icon= "fa-solid fa-pen-paintbrush"> </Feature>
        </div>
        <div class="col d-flex justify-content-center ">
          <Feature description="Obtén los datos de tus clientes solo con el número de documento" icon="fa-solid fa-user"></Feature>
        </div>
        <div class="col d-flex justify-content-center ">
          <Feature description="Obtener reportes de los movimientos de tu negocio" icon="fa-solid fa-briefcase"></Feature>
        </div>
      </div>

      
      <!-- Segunda Fila -->
      <div class="row justify-content-center">
        <div class="col d-flex justify-content-center">
          <Feature description="Usa tu propio certificado digital para enviar tus comprobantes a SUNAT" islocal = {true} icon_local="/sunat.svg"  ></Feature>
        </div>
        <div class="col d-flex justify-content-center ">
          <Feature description="Imprime tus comprobantes en formato A4, A5, 80mm o 58mm" icon="fa-solid fa-print"></Feature>
        </div>
        <div class="col d-flex justify-content-center ">
          <Feature description="Lleva el control de tu inventario, valores y stock de forma correcta" icon="fa-solid fa-boxes-stacked"></Feature>
        </div>
      </div>
    </div>

    <!-- insertar un video -->
    <div class="video-container">
      <iframe
          src="https://www.youtube.com/embed/9Rks0Gflci8"
          title="YouTube video player"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
      ></iframe>
    </div>


  </Section> 
  
  <Section title="Fortalece tu Negocio" background_color = {back_color_secondary} font_color="white" >
    
    <div class="container numeros-negocio">
      <div class="row">
        <div class="col-6  d-flex flex-column justify-content-center align-items-center">
          <h1 class="fw-bold">500+</h1>
          <p class="text-center" >Archivos generados</p>
        </div>

        <div class="col-6  d-flex flex-column justify-content-center align-items-center">
          <h1 class="fw-bold" >100+</h1>
          <p class="text-center" >Empresas trabajando</p>
        </div>

        <div class="col-6  d-flex flex-column justify-content-center align-items-center">
          <h1 class="fw-bold">300+</h1>
          <p  class="text-center" > Comprobantes emitidos</p>
        </div>      
      
        <div class="col-6  d-flex flex-column justify-content-center align-items-center">
          <h1 class="fw-bold" >1000+</h1>
          <p class="text-center" >Notas de venta</p>
        </div>
      </div>
    </div>
  
  </Section>


  <Section title="Ellos ya confían en nosotros">
    <div class="container">
      <div class="row d-flex justify-content-center">
        <div class="col-5 logo-empresa d-flex justify-content-center align-items-center">
          <img src="/Empresas/Trokelart.jpeg" alt="" class="img-fluid">
        </div>
        <div  class="col-5 logo-empresa d-flex justify-content-center align-items-center">
          <img src="/Empresas/cool.png" alt="" class="img-fluid">
        </div>
        <div class="col-5 logo-empresa d-flex justify-content-center align-items-center">
          <img src="/Empresas/Matprofer.JPG" alt="" class="img-fluid">
        </div>
        <div class="col-5 logo-empresa d-flex justify-content-center align-items-center">
          <img src="/Empresas/glasse.jpg" alt="" class="img-fluid">
        </div>
      <!--  Mostrar todas las imagenes-->
        <div class="col-5 logo-empresa d-flex justify-content-center align-items-center">
          <img src="/Empresas/abast%20mc.jpg" alt="" class="img-fluid">
        </div>

        <div class="col-5 logo-empresa d-flex justify-content-center align-items-center">
          <img src="/Empresas/aqua%20vit.jpg" alt="" class="img-fluid">
        </div>

        <div class="col-5 logo-empresa d-flex justify-content-center align-items-center">
          <img src="/Empresas/corazon.jpg" alt="" class="img-fluid">
        </div>

        <div class="col-5 logo-empresa d-flex justify-content-center align-items-center">
          <img src="/Empresas/diracc.jpg" alt="" class="img-fluid">
        </div>
        <div class="col-5 logo-empresa d-flex justify-content-center align-items-center">
          <img src="/Empresas/el%20dorado.jpg" alt="" class="img-fluid">
        </div>
        <div class="col-5 logo-empresa d-flex justify-content-center align-items-center">
          <img src="/Empresas/el%20mirador.jpg" alt="" class="img-fluid">
        </div>
        <div class="col-5 logo-empresa d-flex justify-content-center align-items-center">
          <img src="/Empresas/im.jpg" alt="" class="img-fluid">
        </div>

        <div class="col-5 logo-empresa d-flex justify-content-center align-items-center">
          <img src="/Empresas/jireh.jpg" alt="" class="img-fluid">
        </div>

        <div class="col-5 logo-empresa d-flex justify-content-center align-items-center">
          <img src="/Empresas/la%20botica.jpg" alt="" class="img-fluid">
        </div>
        <div class="col-5 logo-empresa d-flex justify-content-center align-items-center">
          <img src="/Empresas/luy%20market.jpg" alt="" class="img-fluid">
        </div>
        <div class="col-5 logo-empresa d-flex justify-content-center align-items-center">
          <img src="/Empresas/newid.jpg" alt="" class="img-fluid">
        </div>

        <div class="col-5 logo-empresa d-flex justify-content-center align-items-center">
          <img src="/Empresas/panaderia.jpg" alt="" class="img-fluid">
        </div>

        <div class="col-5 logo-empresa d-flex justify-content-center align-items-center">
          <img src="/Empresas/arios.jpg" alt="" class="img-fluid">
        </div>

        <div class="col-5 logo-empresa d-flex justify-content-center align-items-center">
          <img src="/Empresas/firat.jpg" alt="" class="img-fluid">
        </div>

        <div class="col-5 logo-empresa d-flex justify-content-center align-items-center">
          <img src="/Empresas/la%2039.jpg" alt="" class="img-fluid">
        </div>

        <div class="col-5 logo-empresa d-flex justify-content-center align-items-center">
          <img src="/Empresas/sanfer.jpg" alt="" class="img-fluid">
        </div>

      </div>

    </div>
  </Section>

</Layout>






<style>

  #uno{
    background-color: blueviolet;
  }
  /* Hero */
  .titulo{
    color: white;
    font-size: 5rem;
    font-family: 'Open Sans', sans-serif
  }

  .btn-hero{
    margin-top: 5rem;
    font-size: 1.5rem;
    padding: 0.8rem 2rem;
  }


/* Fortalece tu negocio */
  .numeros-negocio{
    margin-top: 2rem;
  }

  p{
    font-size: 1.2rem;
  }

  /* Ellos ya confian en nosotros */
  .logo-empresa{
    /* borde simple */
    border: 2px solid #eaeaea; 
    margin: 1rem;

    background-color: rgb(255, 255, 255);
    border-radius: 5px;
    height: 8rem ;
  }

  .logo-empresa img{
    max-height: 80%;
  }
  .video-container {
    display: flex;
    justify-content: center;
    width: 60vw;
    height: 20vw;
  }
  .video-container iframe {
    width: 100%;
    height: auto;
    max-width: 800px; /* Opcional: puedes ajustar el valor máximo */
  }


  @media only screen and (max-width: 600px) {
  .titulo{
    font-size: 3rem;
  }
  .btn-hero{
    font-size: 1rem;
    padding: 0.8rem 1rem;
  }

  .logo-empresa{
    /* borde simple */
    margin: 0.5rem;

  }

  .video-container {
    width: 100%;
    height: 50vw;
  }


  }
</style>

