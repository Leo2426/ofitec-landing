---
import Layout from "../layouts/Layout.astro"
import Section from "../components/Section.astro"
import Feature from "../components/Feature.astro"
import Hero from "../components/Hero.astro"

export const back_color_secondary = "rgb(48 48 68)"
---

<Layout title="Ofitec">
  
  <Hero background_image="/public/inicio.png">
    <h1 class="text-center titulo">Sistema de Facturación Electrónica</h1>
    <button type="button" class="btn-hero btn btn-success mx-auto">PROBAR SISTEMA GRATIS</button>
  </Hero>

  <Section title="Controla tu Negocio">

    <div class="container">

      <!-- Primera Fila -->
      <div class="row justify-content-center">
        <div class="col d-flex justify-content-center">
          <Feature description="Agrega tu logo y tus datos para que salga en tus comprobantes" icon= "fa-solid fa-pen-paintbrush"> </Feature>
        </div>
        <div class="col d-flex justify-content-center ">
          <Feature description="Obtén los datos de tus clientes solo con el número de documento" icon="fa-solid fa-user"></Feature>
        </div>
        <div class="col d-flex justify-content-center ">
          <Feature description="Obtener reportes de los movimientos de tu negocio" icon="fa-solid fa-briefcase"></Feature>
        </div>
      </div>

      
      <!-- Segunda Fila -->
      <div class="row justify-content-center">
        <div class="col d-flex justify-content-center">
          <Feature description="Usa tu propio certificado digital para enviar tus comprobantes a SUNAT" islocal = {true} icon_local="/public/sunat.svg"  ></Feature>
        </div>
        <div class="col d-flex justify-content-center ">
          <Feature description="Imprime tus comprobantes en formato A4, A5, 80mm o 58mm" icon="fa-solid fa-print"></Feature>
        </div>
        <div class="col d-flex justify-content-center ">
          <Feature description="Lleva el control de tu inventario, valores y stock de forma correcta" icon="fa-solid fa-boxes-stacked"></Feature>
        </div>
      </div>
    </div>


  </Section> 
  
  <Section title="Fortalece tu Negocio" background_color = {back_color_secondary} font_color="white" >
    
    <div class="container numeros-negocio">
      <div class="row">
        <div class="col col-md-6 d-flex flex-column justify-content-center align-items-center">
          <h1 class="fw-bold">500+</h1>
          <p>Archivos generados</p>
        </div>

        <div class="col col-md-6 d-flex flex-column justify-content-center align-items-center">
          <h1 class="fw-bold" >20+</h1>
          <p>Empresas trabajando</p>
        </div>

        <div class="col col-md-6 d-flex flex-column justify-content-center align-items-center">
          <h1 class="fw-bold">300+</h1>
          <p>Comprobantes emitidos</p>
        </div>      
      
        <div class="col col-md-6 d-flex flex-column justify-content-center align-items-center">
          <h1 class="fw-bold" >1000+</h1>
          <p>Notas de venta</p>
        </div>
      </div>
    </div>
  
  </Section>


  <Section title="Ellos ya confían en nosotros">
    <div class="container">
      <div class="row">
        <div class="col logo-empresa d-flex justify-content-center align-items-center">
          <img src="/public/Empresas/Trokelart.jpeg" alt="" class="img-fluid">
        </div>
        <div class="col logo-empresa d-flex justify-content-center align-items-center">
          <img src="/public/Empresas/cool.png" alt="" class="img-fluid">
        </div>
        <div class="col logo-empresa d-flex justify-content-center align-items-center">
          <img src="/public/Empresas/Matprofer.JPG" alt="" class="img-fluid">
        </div>
        <div class="col logo-empresa d-flex justify-content-center align-items-center">
          <img src="/public/Empresas/glasse.jpg" alt="" class="img-fluid">
        </div>
      </div>
    </div>
  </Section>

</Layout>






<style>

  /* Hero */
  .titulo{
    color: white;
    font-size: 5rem;
    font-family: 'Open Sans', sans-serif
  }

  .btn-hero{
    margin-top: 5rem;
    font-size: 1.5rem;
    padding: 0.8rem 2rem;
  }

/* Fortalece tu negocio */
  .numeros-negocio{
    margin-top: 2rem;
  }

  p{
    font-size: 1.2rem;
  }

  /* Ellos ya confian en nosotros */
  .logo-empresa{
    /* borde simple */
    border: 2px solid #eaeaea; 
    margin-right: 1rem;
    margin-left: 1rem;
    background-color: rgb(255, 255, 255);
    border-radius: 5px;
    height: 8rem ;
  }

  .logo-empresa img{
    max-height: 80%;
  }



</style>