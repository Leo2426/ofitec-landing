---
import Layout from "../layouts/Layout.astro"
import Section from "../components/Section.astro"
---

<Layout>
  <div class="container-fluid d-flex flex-column justify-content-center">
    <h1 class="text-center titulo">Sistema de Facturación Electrónica</h1>
    <button type="button" class="btn-hero btn btn-success mx-auto">PROBAR SISTEMA GRATIS</button>
  </div>



  <Section title="Controla tu Negocio">

    <div class="card card-feature text-center mb-3" style="width: 18rem;">
      
      <div class="card-img d-flex justify-content-center align-items-center"> <!-- Here I create a New Div for image with class name card_img -->
        <i class="fa-solid fa-pen-paintbrush"></i>
      </div>

      <div class="card-body">
        <p class="card-text">With supporting text below as a natural lead-in to additional content.</p>
      </div>
    </div>

  </Section> 
  
  <Section title="Fortalece tu Negocio">

  </Section>


</Layout>






<style>
  i{
    padding: 1.2rem;
    font-size: 3rem;
    color: rgb(255, 255, 255);
    object-fit: cover;
  }


.card-img {
    width: 8rem;
    height: 8rem;
    overflow: hidden;
    border-radius: 100%;
    margin: -60px auto 0;
    background-color: rgb(52, 163, 110);
}



  /* Hero */
  .container-fluid{
    height: 100vh;
    background-color: rgb(7, 37, 60);
  }

  .titulo{
    color: aliceblue;
    font-size: 5rem;
    font-family: 'Open Sans', sans-serif
  }

  .btn-hero{
    margin-top: 5rem;
    font-size: 1.5rem;
    padding: 0.8rem 2rem;
  }

  .card-feature{
    border: none;
    box-shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;
  }

  .card-text{
    padding: 0rem 1rem 1rem 1rem;
  }

  .card{
    border-radius: 10px;
  }

</style>