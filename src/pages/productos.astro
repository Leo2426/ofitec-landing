---
import Layout from "../layouts/Layout.astro"
import { back_color_secondary } from "./index.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";

import { imagen_prueba } from "./nosotros.astro";
---

<Layout>
    <Hero background_image= {imagen_prueba}>
        <div class="container">
            <h1 class="titulo">Planes que se adaptan a tu medida</h1>
            <p class="parrafo">Revisa nuestros planes y elige el que mas se adecúe a tu negocio, recuerda que estos son escalables sin costo adicional</p>
           </div>
    </Hero>

    <Section title="Planes">
      <div class="container">
        <div class="row">

          <!-- Plan Emprende -->
          <div class="col">
            <div class="card-plan">
              <h4 class="encabezado">Emprende</h4>
              <h1 class="precio fw-bold">s/.29 <span class="mes">/mes</span></h1>
              <p class="descripcion">El plan que te ayuda a dar el primer paso</p>

              <div class="content">
                <p><i class="fa-solid fa-circle-check circle-color"></i> Ventas</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> Compras</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> POS</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> Reportes</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> 1 usuario / 1 local</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> Productos</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> 300 CPE al mes</p> <hr>
                <p class="text-decoration-line-through"><i class="fa-solid fa-circle-check circle-uncolor "></i> Inventarios</p> <hr>
                <p class="text-decoration-line-through"><i class="fa-solid fa-circle-check circle-uncolor "></i> Comprobantes avanzados</p> <hr>
                <p class="text-decoration-line-through"><i class="fa-solid fa-circle-check circle-uncolor "></i> Generador link de pago</p> <hr>
                <p class="text-decoration-line-through"><i class="fa-solid fa-circle-check circle-uncolor "></i> Uso de app</p>
              </div>

              <button type="button" class="btn btn-adquirir">Adquirir</button>
            </div>
          </div>

          <!-- PLan Basico -->
