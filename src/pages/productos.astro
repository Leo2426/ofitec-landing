---
import Layout from "../layouts/Layout.astro"
import { WHATSAPP_NUMBER } from "../config/constants";
import Hero from "../components/Hero.astro";

const whatsappLink = (message: string) =>
  `https://api.whatsapp.com/send?phone=${WHATSAPP_NUMBER}&text=${encodeURIComponent(message)}`;
---

<Layout title="Planes y Precios" description="Conoce los planes anuales y semestrales de Ofitec: Básico, Estándar y Premium. Desde S/ 420 por 12 meses o S/ 240 por 6 meses.">

  <!-- ══ HERO ══ -->
  <Hero background_image="/planes.jpg">
    <h1 class="hero-title">Planes que se adaptan<br>a tu medida</h1>
    <p class="hero-sub">Planes que se adaptan a las necesidades de tu negocio.</p>
  </Hero>

  <!-- ══ PLANES ══ -->
  <section class="o-section o-section--subtle">
    <div class="o-wrapper">
      <div class="o-section-header">
        <span class="o-section-header__eyebrow">Precios</span>
        <h2 class="o-section-header__title" id="planes-title">Planes anuales para tu negocio</h2>
        <div class="o-section-header__divider"></div>
        <p class="o-section-header__subtitle">Elige el plan que mejor se adapte a tu negocio. Comienza a facturar electrónicamente y lleva un mejor control de tus operaciones.</p>
      </div>

      <fieldset class="period-selector" hidden>
        <legend class="visually-hidden">Periodo de contratación</legend>
        <label class="period-selector__option">
          <input type="radio" name="plan-period" value="annual" checked>
          <span>Anual</span>
        </label>
        <label class="period-selector__option">
          <input type="radio" name="plan-period" value="semiannual">
          <span>Semestral</span>
        </label>
      </fieldset>

      <div class="planes-grid">

        <!-- Plan Básico -->
        <div class="plan-card" data-plan="Básico" data-annual-price="420" data-semiannual-price="240">
          <div class="plan-badge">Básico</div>
          <div class="plan-header">
            <div class="plan-icon"><i class="fa-solid fa-seedling"></i></div>
            <div class="plan-price" aria-live="polite" aria-atomic="true">
              <span class="price-amount">S/ 420</span>
              <span class="price-period">por 12 meses</span>
            </div>
            <p class="plan-desc">El plan que te ayuda a crecer y organizar mejor tu negocio</p>
          </div>
          <ul class="feature-list">
            <li class="feature-item active"><i class="fa-solid fa-check"></i> Ventas</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> Compras</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> POS</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> Reportes</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> Productos</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> 2 usuarios / 1 local</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> 700 CPE al mes</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> Inventarios</li>
            <li class="feature-item inactive"><i class="fa-solid fa-xmark"></i> App para Android</li>
            <li class="feature-item inactive"><i class="fa-solid fa-xmark"></i> Emitir Guías</li>
            <li class="feature-item inactive"><i class="fa-solid fa-xmark"></i> Módulos avanzados</li>
            <li class="feature-item inactive"><i class="fa-solid fa-xmark"></i> Finanzas</li>
            <li class="feature-item inactive"><i class="fa-solid fa-xmark"></i> Tienda Virtual</li>
            <li class="feature-item inactive"><i class="fa-solid fa-xmark"></i> Contabilidad</li>
          </ul>
          <a class="btn-plan" target="_blank" rel="noopener noreferrer" href={whatsappLink("Hola, estoy interesado en el plan Básico de S/ 420 anuales. ¿Podrían brindarme información y una demostración del sistema?")}>
            <i class="fa-brands fa-whatsapp"></i> Consultar este plan
          </a>
        </div>

        <!-- Plan Standar — destacado -->
        <div class="plan-card plan-featured" data-plan="Estándar" data-annual-price="780" data-semiannual-price="420">
          <div class="plan-popular-tag">Más popular</div>
          <div class="plan-badge featured-badge">Estándar</div>
          <div class="plan-header">
            <div class="plan-icon featured-icon"><i class="fa-solid fa-rocket"></i></div>
            <div class="plan-price" aria-live="polite" aria-atomic="true">
              <span class="price-amount">S/ 780</span>
              <span class="price-period">por 12 meses</span>
            </div>
            <p class="plan-desc">Automatiza tu negocio y controla todas tus actividades</p>
          </div>
          <ul class="feature-list">
            <li class="feature-item active"><i class="fa-solid fa-check"></i> Ventas</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> Compras</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> POS</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> Reportes</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> Productos</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> 4 usuarios / 3 locales</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> 1200 CPE al mes</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> Inventarios</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> App Básico</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> Emitir Guías</li>
            <li class="feature-item inactive"><i class="fa-solid fa-xmark"></i> Módulos avanzados</li>
            <li class="feature-item inactive"><i class="fa-solid fa-xmark"></i> Finanzas</li>
            <li class="feature-item inactive"><i class="fa-solid fa-xmark"></i> Tienda Virtual</li>
            <li class="feature-item inactive"><i class="fa-solid fa-xmark"></i> Contabilidad</li>
          </ul>
          <a class="btn-plan btn-plan-featured" target="_blank" rel="noopener noreferrer" href={whatsappLink("Hola, estoy interesado en el plan Estándar de S/ 780 anuales. ¿Podrían brindarme información y una demostración del sistema?")}>
            <i class="fa-brands fa-whatsapp"></i> Consultar este plan
          </a>
        </div>

        <!-- Plan Premium -->
        <div class="plan-card plan-premium" data-plan="Premium" data-annual-price="1260" data-semiannual-price="600">
          <div class="plan-badge premium-badge">Premium</div>
          <div class="plan-header">
            <div class="plan-icon premium-icon"><i class="fa-solid fa-crown"></i></div>
            <div class="plan-price" aria-live="polite" aria-atomic="true">
              <span class="price-amount">S/ 1,260</span>
              <span class="price-period">por 12 meses</span>
            </div>
            <p class="plan-desc">Una solución de gestión comercial con herramientas avanzadas para negocios que buscan mayor control de sus operaciones.</p>
          </div>
          <ul class="feature-list">
            <li class="feature-item active"><i class="fa-solid fa-check"></i> Ventas</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> Compras</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> POS</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> Reportes</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> Productos</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> Usuarios y locales ilimitados</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> Comprobantes ilimitados</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> Inventarios</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> App Premium</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> Emitir Guías</li>
            <li class="feature-item active feature-item--highlight"><i class="fa-solid fa-check"></i> Módulos avanzados</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> Finanzas</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> Tienda Virtual</li>
            <li class="feature-item active"><i class="fa-solid fa-check"></i> Contabilidad</li>
          </ul>
          <a class="btn-plan btn-plan-premium" target="_blank" rel="noopener noreferrer" href={whatsappLink("Hola, estoy interesado en el plan Premium de S/ 1,260 anuales. ¿Podrían brindarme información y una demostración del sistema?")}>
            <i class="fa-brands fa-whatsapp"></i> Consultar este plan
          </a>
        </div>

      </div>

      <p class="planes-nota">
        ¿Prefieres pagar mensualmente? También contamos con esa modalidad.
        <a href={whatsappLink("Hola, quisiera conocer las opciones de contratación mensual del sistema OFITEC.")} target="_blank" rel="noopener noreferrer">Escríbenos para conocer las opciones disponibles.</a>
      </p>

      <!-- Nota al pie -->
      <div class="planes-nota">
        <i class="fa-solid fa-circle-info"></i>
        Todos los planes incluyen soporte técnico y actualizaciones. ¿Tienes dudas?
        <a href={whatsappLink("Tengo una consulta sobre los planes")} target="_blank" rel="noopener noreferrer">Escríbenos</a>.
      </div>
    </div>
  </section>

  <!-- ══ SOPORTE + STATS ══ -->
  <section class="o-section o-section--dark">
    <div class="o-wrapper">
      <div class="o-section-header">
        <span class="o-section-header__eyebrow">Confiabilidad</span>
        <h2 class="o-section-header__title o-section-header__title--light">Soporte OFITEC</h2>
        <div class="o-section-header__divider"></div>
        <p class="o-section-header__subtitle o-section-header__subtitle--light">Brindamos soporte constante y actualizaciones a todos nuestros clientes.</p>
      </div>

      <div class="soporte-icon">
        <i class="fa-solid fa-headset"></i>
      </div>

      <div class="stats-grid">
        <div class="stat-card">
          <span class="stat-number">500+</span>
          <span class="stat-label">Archivos generados</span>
        </div>
        <div class="stat-card">
          <span class="stat-number">20+</span>
          <span class="stat-label">Empresas trabajando</span>
        </div>
        <div class="stat-card">
          <span class="stat-number">300+</span>
          <span class="stat-label">Comprobantes emitidos</span>
        </div>
        <div class="stat-card">
          <span class="stat-number">1000+</span>
          <span class="stat-label">Notas de venta</span>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  const selector = document.querySelector<HTMLFieldSetElement>('.period-selector');
  const cards = document.querySelectorAll<HTMLElement>('.plan-card[data-plan]');
  const title = document.getElementById('planes-title');
  const formatter = new Intl.NumberFormat('en-US');

  selector?.addEventListener('change', () => {
    const annual = selector.querySelector<HTMLInputElement>('input:checked')?.value === 'annual';
    if (title) title.textContent = `Planes ${annual ? 'anuales' : 'semestrales'} para tu negocio`;

    cards.forEach(card => {
      const amount = card.querySelector<HTMLElement>('.price-amount');
      const period = card.querySelector<HTMLElement>('.price-period');
      const link = card.querySelector<HTMLAnchorElement>('.btn-plan');
      const price = Number(annual ? card.dataset.annualPrice : card.dataset.semiannualPrice);
      if (!amount || !period || !link) return;

      const formattedPrice = `S/ ${formatter.format(price)}`;
      amount.textContent = formattedPrice;
      period.textContent = annual ? 'por 12 meses' : 'por 6 meses';
      const url = new URL(link.href);
      url.searchParams.set('text', `Hola, estoy interesado en el plan ${card.dataset.plan} de ${formattedPrice} ${annual ? 'anuales' : 'semestrales'}. ¿Podrían brindarme información y una demostración del sistema?`);
      link.href = url.toString();

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        amount.animate(
          [{ opacity: 0.5, transform: 'translateY(3px)' }, { opacity: 1, transform: 'translateY(0)' }],
          { duration: 180, easing: 'ease-out' }
        );
      }
    });
  });

  if (selector) selector.hidden = false;
</script>

<style>
  .period-selector {
    display: flex;
    justify-content: center;
    gap: 0.25rem;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto 3rem;
    padding: 0.3rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-0);
  }

  .period-selector[hidden] { display: none; }
  .period-selector__option { position: relative; cursor: pointer; }
  .period-selector__option input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
  }
  .period-selector__option span {
    display: block;
    padding: 0.7rem 1.4rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-weight: 600;
    transition: background var(--transition), color var(--transition);
  }
  .period-selector__option input:checked + span {
    background: var(--color-primary);
    color: #fff;
  }
  .period-selector__option input:focus-visible + span {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .period-selector__option span { transition: none; }
  }

  /* ── Hero ── */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(255,255,255,0.15);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.25);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0.35rem 0.9rem;
    border-radius: 20px;
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 800;
    color: #fff;
    font-family: 'Open Sans', sans-serif;
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .hero-sub {
    font-size: 1.1rem;
    color: rgba(255,255,255,0.85);
    max-width: 560px;
    line-height: 1.65;
    margin: 0;
  }

  /* ── Grid de planes ── */
  .planes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  /* ── Card base ── */
  .plan-card {
    background: var(--color-surface-0);
    border-radius: var(--radius-lg);
    padding: 2rem 1.75rem 1.75rem;
    box-shadow: var(--shadow-md);
    position: relative;
    transition: transform var(--transition), box-shadow var(--transition);
    display: flex;
    flex-direction: column;
  }

  .plan-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }

  /* ── Card Standar destacada ── */
  .plan-featured {
    background: linear-gradient(160deg, var(--color-surface-dark) 0%, var(--color-surface-dark-2) 100%);
    color: white;
    transform: scale(1.04);
    box-shadow: 0 8px 40px rgba(52, 163, 110, 0.35);
    z-index: 1;
  }

  .plan-featured:hover {
    transform: scale(1.04) translateY(-6px);
  }

  .plan-popular-tag {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-primary);
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.3rem 1.1rem;
    border-radius: 20px;
    white-space: nowrap;
  }

  /* ── Card Premium ── */
  .plan-premium {
    border: 2px solid #f0c040;
  }

  /* ── Badge de plan ── */
  .plan-badge {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .featured-badge { color: rgba(255,255,255,0.6); }
  .premium-badge  { color: #c9a227; }

  /* ── Icono ── */
  .plan-icon {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    background: var(--color-primary-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    color: var(--color-primary);
    margin-bottom: 1.2rem;
  }

  .featured-icon { background: rgba(255,255,255,0.12); color: var(--color-primary-light); }
  .premium-icon  { background: rgba(201,162,39,0.12); color: #c9a227; }

  /* ── Precio ── */
  .plan-header { margin-bottom: 1.5rem; }

  .plan-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem;
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .price-amount {
    font-size: clamp(2rem, 3.5vw, 2.6rem);
    font-weight: 800;
    color: var(--color-text);
  }

  .plan-featured .price-amount { color: white; }

  .price-period {
    font-size: 1rem;
    color: var(--color-text-muted);
    font-weight: 500;
    white-space: nowrap;
  }

  .plan-featured .price-period { color: rgba(255,255,255,0.75); }

  .feature-item.feature-item--highlight {
    background: rgba(201,162,39,0.12);
    border-radius: var(--radius-sm);
    padding-inline: 0.6rem;
    font-weight: 700;
  }

  .plan-desc {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .plan-featured .plan-desc { color: rgba(255,255,255,0.65); }

  /* ── Feature list ── */
  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem;
    flex: 1;
    border-top: 1px solid var(--color-border);
    padding-top: 1.2rem;
  }

  .plan-featured .feature-list { border-top-color: rgba(255,255,255,0.1); }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.93rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--color-surface-100);
  }

  .plan-featured .feature-item {
    border-bottom-color: rgba(255,255,255,0.07);
    color: rgba(255,255,255,0.85);
  }

  .feature-item:last-child { border-bottom: none; }

  .feature-item.active i {
    color: var(--color-primary);
    font-size: 0.85rem;
    width: 16px;
    flex-shrink: 0;
  }

  .feature-item.inactive {
    opacity: 0.35;
    text-decoration: line-through;
  }

  .feature-item.inactive i {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    width: 16px;
    flex-shrink: 0;
  }

  /* ── Botones plan ── */
  .btn-plan {
    display: block;
    text-align: center;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: 0.97rem;
    text-decoration: none;
    background: var(--color-primary-light);
    color: white;
    transition: background var(--transition), transform var(--transition);
  }

  .btn-plan:hover {
    background: var(--color-primary);
    color: white;
    transform: translateY(-2px);
  }

  .btn-plan-featured {
    background: var(--color-primary);
    box-shadow: 0 4px 16px rgba(52, 163, 110, 0.4);
  }

  .btn-plan-featured:hover { background: var(--color-primary-hover); }

  .btn-plan-premium { background: #c9a227; }
  .btn-plan-premium:hover { background: #b08f20; }

  /* ── Nota al pie ── */
  .planes-nota {
    margin-top: 2.5rem;
    text-align: center;
    font-size: 0.92rem;
    color: var(--color-text-muted);
  }

  .planes-nota i { color: var(--color-primary); margin-right: 0.3rem; }

  .planes-nota a {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
  }

  .planes-nota a:hover { text-decoration: underline; }

  /* ── Soporte stats ── */
  .soporte-icon {
    text-align: center;
    font-size: 5rem;
    color: var(--color-primary-light);
    margin-bottom: 2.5rem;
    opacity: 0.85;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .stat-card {
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: var(--radius-md);
    padding: 1.75rem 1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    transition: background var(--transition);
  }

  .stat-card:hover { background: rgba(255,255,255,0.12); }

  .stat-number {
    font-size: 2.4rem;
    font-weight: 800;
    color: var(--color-primary-light);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.65);
  }

  /* ── Responsive ── */
  @media (min-width: 901px) {
    .planes-grid {
      align-items: stretch;
      row-gap: 0;
    }

    .plan-card {
      display: grid;
      grid-template-rows: subgrid;
      grid-row: span 4;
      row-gap: 0;
      border: 2px solid transparent;
    }

    .plan-premium { border-color: #f0c040; }

    .feature-list {
      display: grid;
      grid-template-rows: repeat(14, 1fr);
    }

    .plan-featured { transform: none; }
    .plan-featured:hover { transform: translateY(-6px); }
  }

  @media (max-width: 900px) {
    .planes-grid {
      grid-template-columns: 1fr;
      max-width: 420px;
      margin: 0 auto;
    }

    .plan-featured {
      transform: none;
    }

    .plan-featured:hover {
      transform: translateY(-6px);
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .stat-number { font-size: 2rem; }
  }
</style>
