---
import Layout from "../layouts/Layout.astro"
import { back_color_secondary } from "./index.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";

import { imagen_prueba } from "./nosotros.astro";
---

<Layout>
    <Hero background_image= {imagen_prueba}>
        <div class="container">
            <h1 class="titulo">Planes que se adaptan a tu medida</h1>
            <p class="parrafo">Revisa nuestros planes y elige el que mas se adecúe a tu negocio, recuerda que estos son escalables sin costo adicional</p>
           </div>
    </Hero>

    <Section title="Planes">
        <div class="plan">
            <h4>Emprende</h4>
            <h1>s/.29 <span class="mes">/mes</span></h1>
            <p>El plan que te ayuda a dar el plimer paso</p>
            <ul>
                <li>Ventas</li>
                <hr>
                <li>Compras</li>
                <hr>
                <li>POS</li>
            </ul>
            <button type="button" class="btn btn-adquirir">Adquirir</button>
        </div>
    </Section>


</Layout>


<style>
    .titulo{
    color: white;
    font-size: 5rem;
    font-family: 'Open Sans', sans-serif
  }

  .parrafo{
    margin-top: 1rem;
    color: white;
    font-size: 1.8rem;
  }


  /* PLan */
  .mes{
    font-size: 1.2rem;
  }

  hr{
    margin: 0.5rem ;
    width: 100%;
    translate: -1.5rem;
  }

  li{
    /* cambiar el icono */
    /* disminuir el tamano del icono */
    /* list-style-image: url(https://concepto.de/wp-content/uploads/2019/05/leon-sabana-africa-e1559242836802.jpg); */
}


  .plan{
    background-color: blanchedalmond;
    border-radius: 5%;
    padding: 2rem;

  }

  .btn-adquirir{
    background-color: aquamarine;
  }  .btn-adquirir:hover{
    background-color: rgb(53, 194, 126);
  }

</style>