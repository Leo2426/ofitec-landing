---
import Layout from "../layouts/Layout.astro"
import { back_color_secondary } from "./index.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";

import { imagen_prueba } from "./nosotros.astro";

---

<Layout title="Productos">
    <Hero background_image= "/planes.png">
        <div class="container">
            <h1 class="titulo">Planes que se adaptan a tu medida</h1>
            <p class="parrafo">Revisa nuestros planes y elige el que mas se adecúe a tu negocio, recuerda que estos son escalables sin costo adicional</p>
           </div>
    </Hero>

    <Section title="Planes">
      <div class="container">
        <div class="row">

          <!-- Plan Emprende -->
          <div class="col">
            <div class="card-plan">
              <h4 class="encabezado">Emprende</h4>
              <h1 class="precio fw-bold">s/.29 <span class="mes">/mes</span></h1>
              <h1 class="precio-anual fw-bold">s/. 100 <span class="anual">/anual</span></h1>
              <p class="descripcion">El plan que te ayuda a dar el primer paso</p>

              <div class="content">
                <p><i class="fa-solid fa-circle-check circle-color"></i> Ventas</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> Compras</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> POS</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> Reportes</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> 1 usuario / 1 local</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> Productos</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> 300 CPE al mes</p> <hr>
                <p class="text-decoration-line-through"><i class="fa-solid fa-circle-check circle-uncolor "></i> Inventarios</p> <hr>
                <p class="text-decoration-line-through"><i class="fa-solid fa-circle-check circle-uncolor "></i> Comprobantes avanzados</p> <hr>
                <p class="text-decoration-line-through"><i class="fa-solid fa-circle-check circle-uncolor "></i> Generador link de pago</p> <hr>
                <p class="text-decoration-line-through"><i class="fa-solid fa-circle-check circle-uncolor "></i> Uso de app</p>
              </div>
              
              <a class="btn btn-adquirir" target="_blank" href="https://api.whatsapp.com/send?phone=51990645449&text=Quiero el Plan Emprende" role="button">Lo quiero</a>
            </div>
          </div>

          <!-- PLan Basico -->
          <div class="col">
            <div class="card-plan">
              <h4 class="encabezado">Básico</h4>
              <h1 class="precio fw-bold">s/.49 <span class="mes">/mes</span></h1>
              <h1 class="precio-anual fw-bold">s/. 100 <span class="anual">/anual</span></h1>
              <p class="descripcion">El plan que te ayuda crecer y organizar mejor tu negocio</p>

              <div class="content">
                <p><i class="fa-solid fa-circle-check circle-color"></i> Ventas</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> Compras</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> POS</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> Compras</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> Reportes</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> 2 usuario / 1 local</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> Productos</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> 700 CPE al mes</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> App para Android</p> <hr>
                <p class="text-decoration-line-through"><i class="fa-solid fa-circle-check circle-uncolor "></i> Inventarios</p> <hr>
                <p class="text-decoration-line-through"><i class="fa-solid fa-circle-check circle-uncolor "></i> Comprobantes avanzados</p> <hr>
                <p class="text-decoration-line-through"><i class="fa-solid fa-circle-check circle-uncolor "></i> Generador link de pago</p> <hr>
              </div>

              <a class="btn btn-adquirir" target="_blank" href="https://api.whatsapp.com/send?phone=51990645449&text=Quiero el Plan Básico" role="button">Lo quiero</a>
            </div>
          </div>

          <!-- Plan Standar -->
          <div class="col">
            <div class="card-plan standar">
              <h4 class="encabezado">Standar</h4>
              <h1 class="precio fw-bold">s/.79 <span class="mes">/mes</span></h1>
              <h1 class="precio-anual fw-bold">s/. 100 <span class="anual">/anual</span></h1>
              <p class="descripcion">Automatiza tu negocio y controla tus actividades</p>

              <div class="content">
                <p><i class="fa-solid fa-circle-check circle-color"></i> Ventas</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> Compras</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> POS</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> Reportes</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> 4 usuario / 3 local</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> Productos</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> 1200 CPE al mes</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> Inventario</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> App para Android</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color "></i> Generador link de pago</p> <hr>
                <p class="text-decoration-line-through"><i class="fa-solid fa-circle-check circle-uncolor "></i> Comprobantes avanzados</p> <hr>
                <p class="text-decoration-line-through"><i class="fa-solid fa-circle-check circle-uncolor "></i> Contabilidad</p> <hr>
                <p class="text-decoration-line-through"><i class="fa-solid fa-circle-check circle-uncolor "></i> Finanzas</p> <hr>
                <p class="text-decoration-line-through"><i class="fa-solid fa-circle-check circle-uncolor "></i> Tienda Virtual</p> <hr>
              </div>

              <a class="btn btn-adquirir" target="_blank" href="https://api.whatsapp.com/send?phone=51990645449&text=Quiero el Plan Standar" role="button">Lo quiero</a>
            </div>
          </div>

          <!-- Plan Premium -->
          <div class="col">
            <div class="card-plan">
              <h4 class="encabezado">Premium</h4>
              <h1 class="precio fw-bold">s/.119 <span class="mes">/mes</span></h1>
              <h1 class="precio-anual fw-bold">s/. 100 <span class="anual">/anual</span></h1>
              <p class="descripcion">Un plan que te permite tener tu negocio automatizado sin límites</p>

              <div class="content">
                <p><i class="fa-solid fa-circle-check circle-color"></i> Ventas</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> Compras</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> POS</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> Reportes</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> Usuarios y locales ilimitados</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> Productos</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> Comprobantes ilimitados</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> Inventario</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color"></i> App para Android</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color "></i> Generador link de pago</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color "></i> Comprobantes avanzados</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color "></i> Contabilidad</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color "></i> Finanzas</p> <hr>
                <p><i class="fa-solid fa-circle-check circle-color "></i> Tienda Virtual</p> <hr>
              </div>

              <a class="btn btn-adquirir" target="_blank" href="https://api.whatsapp.com/send?phone=51990645449&text=Quiero el Plan Premium" role="button">Lo quiero</a>
            </div>
          </div>

        </div>
      
      </div>



    </Section>



    <Section title="Soporte OFITEC" background_color= {back_color_secondary} font_color="white">
      <div class="container">
        <p>Brindamos soporte constante y actualizaciones a todos nuestros clientes.
          Nuestros clientes satisfechos recomiendan nustros servicio y su actividad se ve reflejada en datos de trabajo constante</p>
          
          <div class="d-flex flex-column align-items-center">
            <i class="fa-solid fa-headset"></i>
          </div>

          <div class="row">
            <div class="col d-flex flex-column align-items-center">
              <h1 class="numeros">500+</h1>
              <p>Archivos generados</p>
            </div>

            <div class="col d-flex flex-column align-items-center">
              <h1 class="numeros">20+</h1>
              <p>Empresas trabajando</p>
            </div>

            <div class="col d-flex flex-column align-items-center">
              <h1 class="numeros">300+</h1>
              <p>Comprobantes emitidos</p>
            </div>

            <div class="col d-flex flex-column align-items-center">
              <h1 class="numeros">1000+</h1>
              <p>Notas de venta</p>
            </div>


          </div>
        </div>
    </Section>

</Layout>


<style>
    .titulo{
    color: white;
    font-size: 5rem;
    font-family: 'Open Sans', sans-serif
  }

  .parrafo{
    margin-top: 1rem;
    color: white;
    font-size: 1.8rem;
  }


  /* PLan */

  .encabezado{
    margin-top: 0.5rem;
    margin-bottom: 0.8rem;
    color: rgb(52, 163, 110);
    font-size: 1rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.2rem
  }

  .mes{
    font-size: 1.2rem;
    color: dimgrey;
  }

  .anual{
    font-size: 0.8rem;
    color: dimgrey;
    color: rgb(52, 163, 110);
  }

  .precio-anual{
    font-size: 1rem;
    color: rgb(52, 163, 110);
    transform: translateY(-0.3rem);

  }

  .descripcion{
    margin-bottom: 1.8rem;
  }

  .card-plan{
    background-color: rgb(255, 255, 255);
    border-radius: 10px;
    padding: 2rem;
    box-shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;
  }

  .btn-adquirir{
    background-color:  rgb(55, 207, 134);
    color: white;
    margin-top: 1rem;
    /* que el boton esté  en el centro del card */
    margin-left: 50%;
    transform: translateX(-50%);

  }  .btn-adquirir:hover{
    background-color: rgb(48, 184, 118);
  }

  .circle-color{
    padding-right: 0.5rem;
    color: rgb(52, 163, 110);
  }

  .circle-uncolor{
    padding-right: 0.5rem;
  }

  .standar{
    background-color: rgb(220, 255, 113);
  } .standar .btn-adquirir{
    background-color: rgba(255, 21, 9, 0.812);
  }.standar .btn-adquirir:hover{
    background-color: rgba(214, 23, 13, 0.812);
  }

  .col:hover{
    transform: scale(1.02);
    transition: 0.8s;
  }

  .btn:hover{
    color: white;
  }


/* Soporte OFitec */
  .fa-headset{
    font-size: 8rem;
    margin: 4rem;
  }

  .numeros{
    font-size: 2.5rem;
    font-weight: bold;
  }
  p{
    font-size: 1.2rem;
  }

</style>
