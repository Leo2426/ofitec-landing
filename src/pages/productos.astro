<style>
    .titulo{
    color: white;
    font-size: 5rem;
    font-family: 'Open Sans', sans-serif
  }

  .parrafo{
    margin-top: 1rem;
    color: white;
    font-size: 1.8rem;
  }


  /* PLan */

  .encabezado{
    margin-top: 0.5rem;
    margin-bottom: 0.8rem;
    color: rgb(52, 163, 110);
    font-size: 1rem;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.2rem
  }

  .mes{
    font-size: 1.2rem;
    color: dimgrey;
  }

  .descripcion{
    margin-top: 0.8rem;
    margin-bottom: 1.8rem;
  }

  .card-plan{
    background-color: rgb(255, 255, 255);
    border-radius: 10px;
    padding: 2rem;
    box-shadow: rgba(149, 157, 165, 0.2) 0px 8px 24px;
  }

  .btn-adquirir{
    background-color:  rgb(55, 207, 134);
    color: white;
    margin-top: 1rem;
    /* que el boton esté  en el centro del card */
    margin-left: 50%;
    transform: translateX(-50%);

  }  .btn-adquirir:hover{
    background-color: rgb(48, 184, 118);
  }

  .circle-color{
    padding-right: 0.5rem;
    color: rgb(52, 163, 110);;
  }

  .circle-uncolor{
    padding-right: 0.5rem;
  }

</style>