---
import Layout from "../layouts/Layout.astro"
import { back_color_secondary } from "./index.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";

export const imagen_prueba = "https://concepto.de/wp-content/uploads/2019/05/leon-sabana-africa-e1559242836802.jpg"
---

<Layout title="Nosotros">
    <Hero background_image="/team.png">
       <div class="container">
        <h1 class="titulo">El mejor equipo a su servicio</h1>
        <p class="parrafo">Contamos con un staff de profesionales para birndarle el mejor soporte  para su empresa</p>
       </div>
    </Hero>

    <Section title="Somos OFITEC" background_color= {back_color_secondary} font_color="white">
        <div class="container">
            <div class="row">
                <div class="col-12 my-4 d-flex flex-column align-items-center">
                    <h1 class="text-center" >Nuestra Empresa</h1>
                    <p class="descripcion">Somos Ofitec una Empresa dedicada a brindar sistemas digitales para organizar y analizar la informaciön de su emprendimiento o negocios de una forma sencilla y con un bajo costo. Además te
                        brindamos accesorios para equipar tu negocio.</p>
                        <i class="fas fa-computer-speaker"></i>
                </div>
                
                <div class="col-12 my-4 d-flex flex-column align-items-center">
                    <h1>Nuestra Misión</h1>
                    <p class="descripcion">Somos Ofitec una Empresa dedicada a brindar sistemas digitales para organizar y analizar la informaciön de su emprendimiento o negocios de una forma sencilla y con un bajo costo. Además te
                        brindamos accesorios para equipar tu negocio.</p>
                        <i class="fas fa-globe-americas"></i>
                </div>
            </div>
        </div>
    </Section>


    <Section title="Nuestro Equipo">
        <div class="container mt-5">
            <div class="row">
                <div class="col mb-5 d-flex flex-column align-items-center">
                    <img src={imagen_prueba} class="imagen" alt="CEO">
                    <h1 class="nombre text-center">Brian Fernandez Medina</h1>
                    <h2 class="cargo">CEO</h2>
                </div>
                <div class="col d-flex flex-column align-items-center">
                    <img src={imagen_prueba} class="imagen" alt="Administradora">
                    <h1 class="nombre text-center">Luz Marlene Campos González</h1>
                    <h2 class="cargo">Administradora</h2>
                </div>
            </div>
        </div>
    </Section>

</Layout>


<style>

.titulo{
    color: white;
    font-size: 5rem;
    font-family: 'Open Sans', sans-serif
  }

  .parrafo{
    margin-top: 1rem;
    color: white;
    font-size: 1.8rem;
  }

  i{
    font-size: 10rem;
    color: white;
  }


  /* Nuestro Equipo */

    .imagen{
        width: 300px;
        height: 300px;
        border-radius: 50%;
        /* Para que la imagen no se desproporcione */
        object-fit: cover;
    }

    .nombre{
        font-size: 1.8rem;
        font-weight: bold;
        margin-top: 1rem;
        text-transform: uppercase;
    }

    .cargo{
        font-size: 1.6rem;
        font-weight: bold;
        color: rgb(52, 163, 110);
    }

    p{
    font-size: 1.2rem;
    
  }

  .col p {
    text-align: justify;
    padding-left: 1rem;
    padding-right: 1rem;
  }

  @media only screen and (max-width: 600px) {
  .titulo{
    font-size: 3rem;
  }
  .parrafo{
    font-size: 1rem;
  }

  p{
    font-size: 1rem;
  }

  .nombre{
        font-size: 1.5rem;

    }

    .cargo{
        font-size: 1.2rem;
        color: rgb(52, 163, 110);
    }

    .imagen{
        width: 200px;
        height: 200px;
    }
    i{
    font-size: 7rem;
    color: white;
  }


}
</style>